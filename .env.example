# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vovo_agent_ai"

# Redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Auth
NEXTAUTH_SECRET="generate-a-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Owner / admin access (see scripts/setup-admin.mjs + scripts/set-admin.mjs)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_TOTP_SECRET=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# AI Providers
# DeepSeek — the production brain (required; paid, usage is token-capped)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
# ElevenLabs voice engine (Phase 2)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Niche research (optional — falls back to the curated mock corpus)
SEARCH_API_KEY=""

# Cron protection (required in production for /api/cron/daily-research and /api/cron/pipeline-tick)
CRON_SECRET="generate-a-random-secret"

# Owner notifications via Telegram (optional — in-app rows are always written).
# The pipeline pings the owner on approvals, holds, publishes and failures.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# YouTube API (Phase 4)
YOUTUBE_API_KEY=""

# Secrets encryption (used when persisting service keys in the database)
SECRETS_ENCRYPTION_KEY=""

# Email delivery (OTP codes, magic links, notifications).
# Primary SMTP provider (used first).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="VOVO Platform <no-reply@vovo.ai>"

# Secondary SMTP provider (automatic failover if the primary fails).
SMTP_SECONDARY_HOST=""
SMTP_SECONDARY_PORT="587"
SMTP_SECONDARY_USER=""
SMTP_SECONDARY_PASS=""
SMTP_SECONDARY_SECURE="false"
SMTP_SECONDARY_FROM="VOVO Platform <no-reply@vovo.ai>"

# Optional: Resend HTTP fallback if no SMTP is configured.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# EMAIL_API_KEY=""  # alternative name for the same provider key
EMAIL_FROM="VOVO Platform <onboarding@resend.dev>"
