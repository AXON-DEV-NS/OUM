{
  "name": "vovo-hero-video",
  "private": true,
  "version": "1.0.0",
  "description": "VOVO Agent AI — hero background video (Remotion). Renders are copied into ../public/video and never touch the Next.js build.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:desktop": "remotion render src/index.ts HeroDesktop ../public/video/hero-desktop.mp4 --codec=h264 --crf=19 --color-space=bt709 --timeout=120000",
    "render:desktop-webm": "remotion render src/index.ts HeroDesktop ../public/video/hero-desktop.webm --codec=vp9 --crf=30 --color-space=bt709 --timeout=120000",
    "render:mobile": "remotion render src/index.ts HeroMobile ../public/video/hero-mobile.mp4 --codec=h264 --crf=21 --color-space=bt709 --timeout=120000",
    "render:mobile-webm": "remotion render src/index.ts HeroMobile ../public/video/hero-mobile.webm --codec=vp9 --crf=34 --color-space=bt709 --timeout=120000",
    "still:desktop": "remotion still src/index.ts HeroDesktop out/hero-desktop-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=82 --timeout=120000",
    "still:mobile": "remotion still src/index.ts HeroMobile out/hero-mobile-poster.jpeg --frame=0 --image-format=jpeg --jpeg-quality=82 --timeout=120000",
    "stills:desktop": "remotion render src/index.ts HeroDesktop out/check3 --frames=30,60,105,165,200,240,265,285,300,330,360,395,420,440,460,479 --image-format=png --timeout=120000",
    "stills:mobile": "remotion render src/index.ts HeroMobile out/check3m --frames=30,60,165,240,300,360,420,460,479 --image-format=png --timeout=120000"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.300",
    "@remotion/google-fonts": "^4.0.300",
    "lucide-react": "^0.544.0",
    "potrace": "^2.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
