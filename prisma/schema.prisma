generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  role          UserRole       @default(CLIENT)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// Free-text style notes and always-include/always-avoid rules for the AI
  /// (persistent and editable later from account settings).
  customInstructions String?  @db.Text
  /// Current onboarding step (1-8). Lets the client resume where they left off.
  onboardingStep     Int       @default(1)
  onboardingCompletedAt DateTime?
  /// When the first-visit dashboard tour was dismissed.
  tourSeenAt         DateTime?
  /// When the one-time welcome splash was dismissed (persisted per account,
  /// consistent across devices — shown exactly once).
  welcomeSeenAt      DateTime?

  sessions      Session[]
  channels      Channel[]
  contentItems  ContentItem[]
  tickets       SupportTicket[]
  subscription  Subscription?
  invoices      Invoice[]
  freeGrants    FreeGrant[]
  notices       UserNotice[]
  runs          Run[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  /// IP address of the session creator — used for anomaly detection
  ipAddress   String?
  /// User-agent string — used for active-session display
  userAgent   String?
  /// Updated on each authenticated request
  lastSeenAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// CHANNEL & CONTENT
// ─────────────────────────────────────────────

model Channel {
  id              String        @id @default(cuid())
  userId          String
  youtubeId       String
  title           String
  thumbnailUrl    String?
  subscriberCount Int           @default(0)
  videoCount      Int           @default(0)
  niche           String?
  /// FK to the shared knowledge-base record for this channel's niche
  nicheId         String?
  markets         String[]      @default(["en"])
  tone            String?
  /// Encrypted OAuth access token (AES-256-GCM)
  accessToken     String?       @db.Text
  /// Encrypted OAuth refresh token (AES-256-GCM)
  refreshToken    String?       @db.Text
  tokenExpiresAt  DateTime?
  /// Whether this channel's content requires a fixed avatar/character
  requiresAvatar  Boolean?
  /// Character turnaround sheet images (front/back/sides) for visual consistency
  avatarSheetUrls String[]      @default([])
  /// Uploaded single avatar image (raw bytes) reused for every video
  avatarImage     Bytes?
  avatarImageMime String?
  /// Reference channel + reference video for the AI to study (validated URLs)
  referenceChannelUrl String?
  referenceVideoUrl   String?
  connectedAt     DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems    ContentItem[]
  nicheRecord     Niche?        @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  runs            Run[]
  dna             ChannelDna?

  @@unique([userId, youtubeId])
  @@index([nicheId])
  @@map("channels")
}

// ─────────────────────────────────────────────
// CONTENT-NICHE KNOWLEDGE BASE
// ─────────────────────────────────────────────

/// A shared, evolving knowledge base for one content niche/category.
/// Every channel in the same niche links to the same record, so
/// knowledge learned from one channel benefits all of them.
model Niche {
  id               String         @id @default(cuid())
  /// Canonical niche key, e.g. "technology", "gaming"
  name             String         @unique
  /// Human description of the niche (seeded from onboarding)
  description      String?        @db.Text
  /// DeepSeek market/audience/competitor analysis captured during onboarding
  analysis         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// When the daily research job last ran for this niche
  lastResearchedAt DateTime?

  bestPractices    BestPractice[]
  thingsToAvoid    ThingToAvoid[]
  mistakeLogs      MistakeLog[]
  channels         Channel[]

  @@map("niches")
}

/// What works / what to do, learned through research or experience
model BestPractice {
  id           String   @id @default(cuid())
  nicheId      String
  /// Short statement of what works / what to do
  title        String
  /// Explanation of how to apply it
  description  String   @db.Text
  /// Where this was learned ("initial research", "daily research", or a URL)
  source       String?
  discoveredAt DateTime @default(now())

  niche        Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@unique([nicheId, title])
  @@index([nicheId])
  @@map("best_practices")
}

/// What not to do, learned through research or experience
model ThingToAvoid {
  id           String   @id @default(cuid())
  nicheId      String
  title        String
  description  String   @db.Text
  source       String?
  discoveredAt DateTime @default(now())

  niche        Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@unique([nicheId, title])
  @@index([nicheId])
  @@map("things_to_avoid")
}

/// A record of a specific mistake the AI made while producing content
/// for this niche — checked against before producing future content.
/// Shared across channels: one channel's mistake prevents the same
/// mistake on every channel in the niche.
model MistakeLog {
  id          String   @id @default(cuid())
  nicheId     String
  /// Channel where the mistake happened (nullable — knowledge is shared)
  channelId   String?
  /// What the AI did wrong
  title       String
  /// Context: what happened
  description String   @db.Text
  /// What to do instead going forward
  correction  String   @db.Text
  occurredAt  DateTime @default(now())

  niche       Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId])
  @@index([channelId])
  @@map("mistake_logs")
}

/// Tracks every AI-managed video through its full lifecycle
model ContentItem {
  id              String          @id @default(cuid())
  channelId       String
  userId          String
  title           String
  /// Full AI-generated or human-edited script
  scriptText      String?         @db.Text
  /// Structured production plan (hook, scenes, visual prompts, voice direction)
  productionPlan  Json?
  /// JSON array of media asset URLs (thumbnail, video, etc.)
  mediaUrls       String[]        @default([])
  status          ContentStatus   @default(IDEA)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  /// Comments attached to the latest review action
  reviewComment   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  channel         Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory   ContentStatusEvent[]

  @@index([channelId])
  @@index([userId])
  @@index([userId, status])
  @@index([channelId, status])
  @@index([scheduledAt])
  @@map("content_items")
}

/// Immutable log of every status transition on a ContentItem
model ContentStatusEvent {
  id            String        @id @default(cuid())
  contentItemId String
  fromStatus    ContentStatus?
  toStatus      ContentStatus
  /// Who triggered the transition: "ai_agent", "client", or an admin userId
  actor         String
  comment       String?
  createdAt     DateTime      @default(now())

  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@map("content_status_events")
}

// ─────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  plan                PlanTier           @default(STARTER)
  status              SubscriptionStatus @default(TRIALING)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean            @default(false)
  /// TODO: connect real billing provider — store external subscription ID here
  externalId          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices            Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                  String          @id @default(cuid())
  subscriptionId      String
  userId              String
  amountCents         Int
  currency            String          @default("usd")
  status              InvoiceStatus   @default(PENDING)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  /// TODO: connect real billing provider — store external invoice/payment-intent ID here
  externalId          String?
  pdfUrl              String?
  createdAt           DateTime        @default(now())

  subscription        Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("invoices")
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  subject     String
  description String         @db.Text
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  /// null = system/AI message
  userId    String?
  content   String        @db.Text
  /// true if the reply came from a staff/admin account
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

// ─────────────────────────────────────────────
// AUDIT & SECURITY (ADMIN & SYSTEM LAYER)
// ─────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String
  actorRole    String?  @default("client")
  targetUserId String?
  metadata     Json?
  ipAddress    String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

model SecurityChatMessage {
  id        String   @id @default(cuid())
  sender    String   // "admin" | "guardian"
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("security_chat_messages")
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // "NEW_DEVICE_LOGIN", "FAILED_MAGIC_LINK", "RATE_LIMIT_EXCEEDED", "TEMPORARY_LOCKOUT"
  email     String?
  ipAddress String?
  userAgent String?
  severity  String   @default("INFO")
  details   Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("security_events")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  VISITOR
  CLIENT
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ContentStatus {
  IDEA
  SCRIPT
  GENERATING
  READY_FOR_REVIEW
  SCHEDULED
  PUBLISHED
  REJECTED
}

enum PlanTier {
  STARTER
  GROWTH
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}


// ---------------------------------------------
// SECRETS VAULT (admin-managed external API keys)
// ---------------------------------------------

/// Encrypted storage for external service API keys, managed from the
/// admin panel. `encryptedValue` holds an AES-256-GCM ciphertext; the raw
/// value is never stored or returned to the client.
model ApiServiceKey {
  id             String   @id @default(cuid())
  serviceKey     String   @unique
  label          String
  envVar         String
  encryptedValue String
  updatedAt      DateTime @default(now())

  @@map("api_service_keys")
}

/// Quota-saving cache for YouTube Data API responses.
/// The free quota is 10,000 units/day — search.list alone costs 100 units,
/// so every response is cached and reused before any new call is made.
model YouTubeCache {
  key       String   @id
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("youtube_cache")
}

/// Quota state for the web-search providers (Tavily primary, Serper fallback).
/// Tavily renews monthly; Serper is a one-time balance that never renews.
model SearchProviderState {
  provider       String    @id
  /// When set in the future, the provider is skipped until this moment
  exhaustedUntil DateTime?
  /// True when the provider must never be called again (Serper balance gone)
  disabled       Boolean   @default(false)
  lastError      String?
  updatedAt      DateTime  @updatedAt

  @@map("search_provider_state")
}

/// Cached web-search results — repeated/common queries never spend quota twice.
model SearchCache {
  key       String   @id
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("search_cache")
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS & ADMIN CONTROLS
// ─────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType String    // "percent" | "fixed"
  discountValue Float
  active       Boolean   @default(true)
  expiryDate   DateTime?
  maxUses      Int?
  usedCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("promo_codes")
}

model FreeGrant {
  id           String    @id @default(cuid())
  userId       String?
  planId       String?
  durationDays Int
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("free_grants")
}

model UserNotice {
  id        String   @id @default(cuid())
  userId    String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("user_notices")
}

// ─────────────────────────────────────────────
// PIPELINE ENGINE (constitution V1)
// 8 new tables; users / channels / audit_logs already exist.
// Flexible payloads live in JSON columns; no speculative tables.
// ─────────────────────────────────────────────

enum RunPath {
  AVATAR
  FACELESS
  MIXED
}

enum RunMode {
  COPILOT
  AUTOPILOT
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_HUMAN
  HOLD
  FAILED
  PUBLISHED
  DONE
}

enum StageStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  RETRY
  SKIPPED
  WAITING
}

/// Compiled, versioned channel DNA. One active record per channel.
model ChannelDna {
  id          String    @id @default(cuid())
  channelId   String    @unique
  version     Int       @default(1)
  /// Compiled rules extracted from user instructions (JSON)
  rules       Json
  /// Detected rule conflicts, if any (JSON)
  conflicts   Json?
  competitors Json?
  audience    Json?
  avatar      Json?
  mode        Json
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_dna")
}

/// One production run = 13 stages from setup to learning.
model Run {
  id             String     @id @default(cuid())
  userId         String
  channelId      String
  nicheKey       String?
  path           RunPath
  mode           RunMode    @default(COPILOT)
  status         RunStatus  @default(QUEUED)
  /// Index of the next stage to execute (0-12)
  currentStage   Int        @default(0)
  /// Hard budget cap for this run, in cents
  costCapCents   Int
  costSpentCents Int        @default(0)
  locale         String     @default("en")
  scheduledFor   DateTime?
  /// Caller-supplied dedupe key; unique when present
  idempotencyKey String?    @unique
  lastError      String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  stages         RunStage[]
  assets         Asset[]
  ledger         CostLedger[]
  qaReports      QaReport[]
  notifications  Notification[]

  @@index([userId, status])
  @@index([channelId, status])
  @@index([status, scheduledFor])
  @@map("runs")
}

/// Per-stage execution state of a run. One row per (run, stage).
model RunStage {
  id            String      @id @default(cuid())
  runId         String
  /// "S0" .. "S12"
  stageKey      String
  index         Int
  status        StageStatus @default(PENDING)
  attempts      Int         @default(0)
  /// Free-form resumable state (sub-steps, timers, sub-scores)
  checkpoint    Json?
  input         Json?
  output        Json?
  score         Int?
  /// { skillKey: version } actually executed for this stage
  skillVersions Json?
  error         String?     @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  run           Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  qaReports     QaReport[]

  @@unique([runId, stageKey])
  @@index([runId, index])
  @@map("run_stages")
}

/// Immutable record of every produced artifact (generated or licensed).
model Asset {
  id          String   @id @default(cuid())
  runId       String
  /// "image" | "audio" | "video" | "text" | "subtitle"
  kind        String
  stage       String?
  filePath    String?
  mimeType    String?
  bytes       Int?
  width       Int?
  height      Int?
  durationSec Float?
  /// "generated" | "licensed" | "uploaded"
  source      String
  provider    String?
  license     String?
  licenseUrl  String?
  meta        Json?
  createdAt   DateTime @default(now())

  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
  @@map("assets")
}

/// Every deterministic check and every judge verdict. Append-only.
model QaReport {
  id          String   @id @default(cuid())
  runId       String
  stageKey    String
  stageRowId  String?
  checkKey    String
  /// "deterministic" | "judge" | "gate"
  kind        String
  score       Int?
  passed      Boolean
  reasons     Json?
  action      String?
  judgeModel  String?
  writerModel String?
  createdAt   DateTime @default(now())

  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stageRow    RunStage? @relation(fields: [stageRowId], references: [id], onDelete: SetNull)

  @@index([runId, stageKey])
  @@map("qa_reports")
}

/// Append-only cost log. Amounts in cents (integer).
model CostLedger {
  id        String   @id @default(cuid())
  runId     String
  stageKey  String
  provider  String
  operation String
  units     Json?
  costCents Int
  currency  String   @default("usd")
  meta      Json?
  createdAt DateTime @default(now())

  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("cost_ledger")
}

/// Shared niche knowledge base: lessons learned across runs.
/// A lesson only becomes "active" after it repeats (occurrences >= 2).
model NicheKb {
  id          String   @id @default(cuid())
  nicheKey    String
  scope       String   @default("niche")
  channelId   String?
  lesson      String   @db.Text
  lessonHash  String
  evidence    Json?
  confidence  Int      @default(1)
  occurrences Int      @default(1)
  status      String   @default("pending")
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([nicheKey, lessonHash])
  @@index([nicheKey, status])
  @@map("niche_kb")
}

/// In-app + Telegram notifications. One row per notification, always.
model Notification {
  id        String    @id @default(cuid())
  userId    String?
  runId     String?
  /// "in_app" | "telegram"
  channel   String
  /// "approval_needed" | "provider_missing" | "budget_hold" | "publish_done" | ...
  kind      String
  title     String
  body      String    @db.Text
  data      Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       Run?      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([runId])
  @@map("notifications")
}

